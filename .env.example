# ─────────────────────────────────────────────────────────────
# ARIA Trading Intelligence System — Environment Variables
# Copy this to .env and fill in your real keys
# ─────────────────────────────────────────────────────────────

# ── Alpaca Markets ────────────────────────────────────────────
# Get from: https://alpaca.markets → Paper Trading API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true   # Set to "false" for LIVE trading (be careful!)

# ── Interactive Brokers ───────────────────────────────────────
# Requires TWS or IB Gateway running locally with API enabled
# TWS Paper:    port 7497
# TWS Live:     port 7496
# GW Paper:     port 4002
# GW Live:      port 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# ── Anthropic (ARIA cognitive layer) ─────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── News / Macro APIs ─────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here

# ── Access control ───────────────────────────────────────────────────────────
# ARIA is single-owner. You get everything: vault, portfolio, execution, the
# cloud model. Everyone else is a free tier with research access only.
#
# Set this before the API is reachable from anywhere but this machine. With it
# unset, owner access is granted by loopback alone — fine on a laptop, not fine
# on the mini. Send it as `Authorization: Bearer <token>` or `X-ARIA-Token`.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARIA_OWNER_TOKEN=

# Model every non-owner gets. Small deliberately: the 24/7 host is a 2014 Intel
# Mac mini with no usable GPU, where a 7B answers in minutes, not seconds.
ARIA_FREE_MODEL=gemma3:4b
