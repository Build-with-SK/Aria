# ─────────────────────────────────────────────────────────────
# ARIA Trading Intelligence System — Environment Variables
# Copy this to .env and fill in your real keys
# ─────────────────────────────────────────────────────────────

# ── Alpaca Markets ────────────────────────────────────────────
# Get from: https://alpaca.markets → Paper Trading API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true   # Set to "false" for LIVE trading (be careful!)

# ── Interactive Brokers ───────────────────────────────────────
# Requires TWS or IB Gateway running locally with API enabled
# TWS Paper:    port 7497
# TWS Live:     port 7496
# GW Paper:     port 4002
# GW Live:      port 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# ── Anthropic (ARIA cognitive layer) ─────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── News / Macro APIs ─────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here

# ── Access control ───────────────────────────────────────────────────────────
# ARIA is single-owner. You get everything: vault, portfolio, execution, the
# cloud model. Everyone else is a free tier with research access only.
#
# Set this before the API is reachable from anywhere but this machine. With it
# unset, owner access is granted by loopback alone — fine on a laptop, not fine
# on the mini. Send it as `Authorization: Bearer <token>` or `X-ARIA-Token`.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ARIA_OWNER_TOKEN=

# Set this to 1 whenever anything sits in front of the app — Cloudflare tunnel,
# nginx, any reverse proxy. Two things depend on it:
#   * X-Forwarded-For / CF-Connecting-IP are only believed for rate limiting
#     when it is set. Believed unconditionally, every limit is bypassable.
#   * The "requests from 127.0.0.1 are the owner" fallback is RETIRED when it
#     is set, because a proxy connects from loopback — so without this, every
#     caller on earth arrives looking like localhost.
# Leaving it unset while running behind a tunnel is the misconfiguration that
# opens the app up. Routes that can reach a broker refuse inferred ownership
# outright, so the worst case is a refusal rather than a stranger's order — but
# set it anyway.
ARIA_TRUST_PROXY=

# Model every non-owner gets. Small deliberately: the 24/7 host is a 2014 Intel
# Mac mini with no usable GPU, where a 7B answers in minutes, not seconds.
ARIA_FREE_MODEL=gemma3:4b

# ── Sign-in (OAuth) ──────────────────────────────────────────────────────────
# Nobody reaches ARIA without signing in. Register an OAuth app with each
# provider you want to offer and paste the credentials here; providers you skip
# appear greyed on the login page with the reason, rather than failing.
#
# Callback URL to register with every provider (must match EXACTLY):
#   http://localhost:8000/api/auth/callback/<provider>
# Change the host here and at the provider together when you move to the mini.
ARIA_BASE_URL=http://localhost:8000
ARIA_FRONTEND_URL=http://localhost:3000

# You are the owner iff the email the provider confirms matches this. Leave it
# blank and NOBODY is owner over OAuth — deliberately, since this is the one
# account that can move money. Falls back to ARIA_OWNER_TOKEN.
ARIA_OWNER_EMAIL=

# Signs the session cookie. Optional: a random key is generated and persisted
# to data/.session_key on first run. Set it explicitly to keep sessions valid
# across a rebuild, or to share one key between machines.
ARIA_SESSION_SECRET=

# Google  — console.cloud.google.com > APIs & Services > Credentials
#           OAuth client ID, type "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub  — github.com/settings/developers > New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple   — needs a PAID Apple Developer account, and its "secret" is an
#           ES256 JWT generated from a .p8 key, not a static string. It also
#           needs the `cryptography` package, which this project does not
#           install. Left unconfigured, Apple shows greyed with that reason.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
