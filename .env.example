# ─────────────────────────────────────────────────────────────
# ARIA Trading Intelligence System — Environment Variables
# Copy this to .env and fill in your real keys
# ─────────────────────────────────────────────────────────────

# ── Alpaca Markets ────────────────────────────────────────────
# Get from: https://alpaca.markets → Paper Trading API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true   # Set to "false" for LIVE trading (be careful!)

# ── Interactive Brokers ───────────────────────────────────────
# Requires TWS or IB Gateway running locally with API enabled
# TWS Paper:    port 7497
# TWS Live:     port 7496
# GW Paper:     port 4002
# GW Live:      port 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# ── Anthropic (ARIA cognitive layer) ─────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── News / Macro APIs ─────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
FRED_API_KEY=your_fred_api_key_here

# ── Access control ───────────────────────────────────────────────────────────
# ARIA is single-owner. The owner credential is configured under "Owner
# sign-in" below. With it unset, owner access is granted by loopback alone —
# fine on a laptop, not fine on the mini — and never reaches a broker.

# Set this to 1 whenever anything sits in front of the app — Cloudflare tunnel,
# nginx, any reverse proxy. Two things depend on it:
#   * X-Forwarded-For / CF-Connecting-IP are only believed for rate limiting
#     when it is set. Believed unconditionally, every limit is bypassable.
#   * The "requests from 127.0.0.1 are the owner" fallback is RETIRED when it
#     is set, because a proxy connects from loopback — so without this, every
#     caller on earth arrives looking like localhost.
# Leaving it unset while running behind a tunnel is the misconfiguration that
# opens the app up. Routes that can reach a broker refuse inferred ownership
# outright, so the worst case is a refusal rather than a stranger's order — but
# set it anyway.
ARIA_TRUST_PROXY=

# Model every non-owner gets. Small deliberately: the 24/7 host is a 2014 Intel
# Mac mini with no usable GPU, where a 7B answers in minutes, not seconds.
ARIA_FREE_MODEL=gemma3:4b

# ── Owner sign-in ────────────────────────────────────────────────────────────
# ONE credential. Generate it — never invent one:
#
#     python scripts/init_owner_auth.py            (plaintext form)
#     python scripts/init_owner_auth.py --hash     (scrypt hash form)
#
# With neither set the server reports SERVER NOT INITIALIZED and nobody can sign
# in. The browser posts this once to /api/auth/login and gets back an HttpOnly
# session cookie; it never holds the credential itself. Scripts send it as
# `Authorization: Bearer <token>` — the break-glass path. See docs/AUTH_SETUP.md.
#
# Google, GitHub and Apple sign-in were removed. GOOGLE_*, GITHUB_*, APPLE_*,
# ARIA_OWNER_EMAIL and ARIA_FRONTEND_URL no longer do anything; delete them.
ARIA_OWNER_TOKEN=
# ARIA_OWNER_TOKEN_HASH=scrypt$...     # wins over ARIA_OWNER_TOKEN if both set

# Signs session ids. Optional: a random key is generated and persisted to
# data/.session_key on first run. Set it explicitly to keep sessions valid
# across a rebuild.
ARIA_SESSION_SECRET=

# The public URL. Only its scheme matters to auth: https here, plus
# ARIA_TRUST_PROXY=1 behind a tunnel, is what marks the cookie Secure.
ARIA_BASE_URL=http://localhost:8000

# ── The two peer credentials ─────────────────────────────────────────────────
# Three secrets, three jobs, three values. Generate both with
# `python scripts/init_service_tokens.py --apply`, which writes the same value
# into both applications' .env files and refuses to let any two of them match.
#
#   ARIA_OWNER_TOKEN        human    -> ARIA        (above; ARIA's .env only)
#   ARIA_SERVICE_TOKEN      SENTINEL -> ARIA        (both .env files)
#   SENTINEL_SERVICE_TOKEN  ARIA     -> SENTINEL    (both .env files)
#
# ARIA_SERVICE_TOKEN opens a method-and-path allowlist (src/auth/policy.py) and
# NOTHING else — no execution route, no vault, no chat. SENTINEL never holds
# ARIA_OWNER_TOKEN: that one reaches the broker.
ARIA_SERVICE_TOKEN=
SENTINEL_SERVICE_TOKEN=

# ── Autonomous trading ───────────────────────────────────────────────────────
# The execution mode (RESEARCH / PAPER / LIVE_AUTONOMOUS) lives in
# data/trading/mode.json and is changed through /api/trading/mode with a typed
# confirmation phrase. LIVE_AUTONOMOUS additionally requires this variable to be
# exactly "true" — it is the out-of-process switch, so nothing running inside
# ARIA, including a model, can open it. Leave it unset unless you mean it.
# ARIA_LIVE_TRADING_ENABLED=true
#
# The emergency stop, readable without the app running. Set to 1/true/yes and
# every order path refuses, including cancels-only recovery. Clearing it needs a
# restart — which is the point.
# ARIA_KILL_SWITCH=1
