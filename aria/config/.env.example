# ARIA Configuration
# Copy this file to config/.env and fill in your values

# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your Obsidian vault path (Windows path example)
OBSIDIAN_VAULT_PATH=C:\Users\sound\Documents\DigitalBrain

# Optional — enhances news sentiment tool
NEWSAPI_KEY=your_newsapi_key_here

# Optional — enables live macro data from FRED
FRED_API_KEY=your_fred_api_key_here
