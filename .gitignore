# ═══════════════════════════════════════════════════════════
#  SECRETS — never commit
# ═══════════════════════════════════════════════════════════
.env
.env.*
*.env
!.env.example
*.key
*.pem
secrets.json
credentials.json

# ═══════════════════════════════════════════════════════════
#  Heavy / generated — keep the repo to source code only
# ═══════════════════════════════════════════════════════════
# Python envs & caches
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Node
node_modules/
dist/
.vite/

# Model files (huge binaries)
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/*.gguf

# Databases & vector stores
*.db
*.sqlite
*.sqlite3
**/chromadb/
data/brain_memory/
data/mind/chromadb/

# Trained ML models (1.5GB+ — regenerated by model_trainer.py)
data/models/
*.pkl
*.joblib
*.h5

# Generated data / caches / outputs
data/cache/
data/raw/
data/reports/
data/execution/approval_queue.json
data/desk/
data/desk_config.json
data/brain_state.json
data/atlas_state.json
data/quant_lab/
# Documents and coursework — never part of the source tree. Six academic PDFs
# and .docx files belonging to a named third party (with their student ID in
# the filename) were committed here in the initial commit; keep them out.
*.pdf
*.docx
*.doc
!docs/**/*.pdf

# V5 prediction log — your own calibration record, not sample data.
# (.gitignore has no trailing comments: a comment on the pattern line makes
#  the whole line a literal path and silently ignores nothing.)
data/v5/
data/outbox/
data/journal/
*.log

# ═══════════════════════════════════════════════════════════
#  OS / editor cruft
# ═══════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Frontier-consult runtime state (toggle + call log)
data/brain_consult.json
data/brain_consult_log.jsonl

data/fx_state.json

# Desk state backups (transient, rotated nightly)
data/backups/

# Superseded pre-refactor snapshots. Untracked from the index but deliberately
# left on disk; without these patterns the next `git add -A` silently re-adds them.
backup_v1_20260531_010758/
main_backup_phase5.py
main_phase4_backup.py
configs/universe_phase4_backup.yaml

# Technical recommendation outcomes — your own hit-rate record, same reasoning
# as data/v5/ above: a real track record, not sample data to ship.
data/technical/

# Session signing key — generated per install. Committing it would let anyone
# mint a cookie for any identity, including the owner.
data/.session_key

# Real cloudflared config carries the tunnel UUID and credentials path.
# Only the .example is tracked.
scripts/cloudflared-config.yml
.cloudflared/

# Local Claude Code settings — per-machine, contains absolute paths.
.claude/settings.local.json

# Launch configurations, for the same reason and one more: they named a home
# directory in four places and pointed at a sibling project on this disk, so a
# public clone advertised both the owner's username and the existence and
# layout of ATLAS. Nothing in it would have worked on another machine anyway.
.claude/launch.json

# Generated by src/scheduler/scheduler.py — contains machine-specific paths.
install_scheduler.ps1
uninstall_scheduler.ps1
docs/audit/PR_BODY.md

# service logs and one-off run logs
data/logs/
wf_rerun.log
backend_run.log

# Research reach: fetched content, provenance index and API keys
data/research/
data/research_keys.json
data/evolution/

# Her voice, her ears, and what they produce.
#
# data/models/ is already excluded above; these are the OUTPUTS. The spoken
# corpus is the owner talking — de-identified, never anonymised — and the
# built datasets are drawn from his vault. Neither is a repository artefact
# and neither should be one commit away from a public remote.
data/audio/
data/training/spoken/
data/training/datasets/
data/training/runs/

# Self-modification worktrees: real git worktrees living under data/. Tracking
# them would nest a checkout inside its own repository.
data/selfmod/worktrees/

# Rotated service logs (data/logs/ is covered above).
data/aria.log*

# Brain baselines: measurements OF THIS MACHINE's model and data, the same
# reasoning as data/v5/ above. Comparing two of them is a local act; shipping
# one would be publishing a number that describes somebody else's hardware.
data/baselines/
